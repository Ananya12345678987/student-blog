# Copy this file to .env.local and fill in real values.
# .env.local is already in .gitignore — never commit real secrets.

# MongoDB Atlas connection string (free M0 cluster).
# Get this from Atlas -> Connect -> "Drivers" after creating a free cluster
# at https://www.mongodb.com/cloud/atlas/register
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student-blog
# Auth.js session signing secret. Generate one with:
#   openssl rand -base64 32
# This must be a real random value in production — never reuse this example.
AUTH_SECRET=replace-with-a-random-32-byte-base64-string

# Base URL of the app. Localhost for dev; your real domain in production.
AUTH_URL=http://localhost:3000
